# Порт Open WebUI на локальном компьютере.
COMPOSE_PROJECT_NAME=local-ai
WEBUI_DATA_VOLUME=local-ai-open-webui-data
WEBUI_PORT=3000
LLM_SERVER_PORT=8080

# Reproducible container images verified together by this project.
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp@sha256:b5e13ddfaa3df76d239ee038075960a46f595201808728fd70bbf2c8b38f6530
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui@sha256:6a773e5c3a246b65cbe74ce942b294292c0e5f81c138f703d111bc162f7d7c3d
OPEN_TERMINAL_IMAGE=ghcr.io/open-webui/open-terminal@sha256:8df3a502a5d35435547d037fa50b5f55323fc5fd0e1b97d2d3d2b5cb42538452

# Default model. Files are downloaded to .model-cache and mounted read-only.
MODEL_API_ID=local/qwen3.8-27b:q5_k_m
MODEL_DISPLAY_NAME=Qwen3.8 27B Q5_K_M Vision
MODEL_GGUF_FILE=Qwen3.8-27B-Q5_K_M.gguf
MODEL_GGUF_URL=https://huggingface.co/unsloth/Qwen3.8-27B-GGUF/resolve/main/Qwen3.8-27B-Q5_K_M.gguf?download=true
MODEL_GGUF_SHA256=07deb7fa91bf751d3000774fe5bb8afae5ffb41255fd19980147468052e07177
MODEL_MMPROJ_FILE=mmproj-F16.gguf
MODEL_MMPROJ_URL=https://huggingface.co/unsloth/Qwen3.8-27B-GGUF/resolve/main/mmproj-F16.gguf?download=true
MODEL_MMPROJ_SHA256=cbb841a9ee0636b2ec172f5bb8df2ea8dfeb01e90fe7c6126581d662a0b4e43e

# Conservative public preset for 24 GB GPUs. See README for a 32 GB preset.
MODEL_CONTEXT_SIZE=65536
MODEL_PARALLEL=1
MODEL_GPU_LAYERS=auto
MODEL_KV_CACHE_TYPE=q4_0
MODEL_IMAGE_MIN_TOKENS=1024
MODEL_SPECULATIVE_TYPE=draft-mtp
MODEL_SPECULATIVE_TOKENS=2

CONTEXT_COMPACTION_ENABLED=true
CONTEXT_COMPACTION_TOKEN_THRESHOLD=40000
CONTEXT_COMPACTION_TOKEN_CAP=40000
CONTEXT_COMPACTION_RETENTION_PERCENTAGE=25

# true: при первом открытии создается локальная учетная запись администратора.
# false: вход отключен; используйте только на доверенном компьютере.
WEBUI_AUTH=true

# start.cmd generates both values automatically when they are empty.
WEBUI_SECRET_KEY=
OPEN_TERMINAL_API_KEY=

# Host-side MCP servers.
COMPUTER_USE_MCP_PORT=8932
CHROME_DEVTOOLS_MCP_PORT=8933
AGENT_CHROME_DEBUG_PORT=9333
# Optional absolute path if Chrome is installed in a non-standard location.
CHROME_EXECUTABLE=

# Portable default: a projects folder next to compose.yaml.
# Absolute Windows paths such as D:/Work/Projects are also supported.
PROJECTS_DIR=./projects

# Optional comma-separated absolute allowlist for Computer's filesystem tool.
# Empty means the resolved PROJECTS_DIR only.
COMPUTER_USE_FS_ROOTS=
COMPUTER_USE_DESTRUCTIVE_REQUIRES_APPROVAL=true
